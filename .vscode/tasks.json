{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    // Press Ctrl+Shift+B to run the "Run Flask Backend" task
    "tasks": [
        {
            "label": "echo",
            "type": "shell",
            "command": "echo Hello"
        },
        {
            "label": "Run Flask Backend",
            "type": "shell",
            "command": "Push-Location -Path ${workspaceFolder}/.. ; python -m web.flask_backend ; Pop-Location",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        }
    ]
}