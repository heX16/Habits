# Main Tracker Screen Layout
# Kivy layout definition for the main habit tracking interface

<MainTrackerScreen>:
    name: 'main'
    
    # Connect UI elements to screen properties
    habit_table: habit_table
    status_bar: status_bar
    
    BoxLayout:
        orientation: 'vertical'
        padding: 10
        spacing: 10
        
        # Header with title and navigation
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: 50
            
            Label:
                text: 'Habits Simple Tracker'
                font_size: 20
                bold: True
                text_size: self.size
                halign: 'left'
                valign: 'middle'
                
            Button:
                text: 'Options'
                size_hint_x: None
                width: 100
                on_press: root.go_to_options()
        
        # Date navigation
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: 40
            spacing: 10
            
            Button:
                text: '← Previous'
                size_hint_x: None
                width: 100
                on_press: root.navigate_previous()
                disabled: root.is_loading
                
            Label:
                text: root.week_label
                text_size: self.size
                halign: 'center'
                valign: 'middle'
                font_size: 16
                
            Button:
                text: 'Next →'
                size_hint_x: None
                width: 100
                on_press: root.navigate_next()
                disabled: root.is_loading
                
            Button:
                text: 'Today'
                size_hint_x: None
                width: 80
                on_press: root.go_to_today()
                disabled: root.is_loading
        
        # Loading indicator
        Label:
            text: 'Loading...' if root.is_loading else ''
            size_hint_y: None
            height: 30 if root.is_loading else 0
            font_size: 14
            opacity: 1 if root.is_loading else 0
        
        # Main habit tracking table
        ScrollView:
            do_scroll_x: True
            do_scroll_y: True
            
            GridLayout:
                id: habit_table
                cols: 8  # Will be updated dynamically (1 for habit name + 7 for days)
                row_default_height: 50
                row_force_default: True
                size_hint_y: None
                height: self.minimum_height
                size_hint_x: None
                width: self.minimum_width
                
                # Header row and habit rows will be added programmatically
                
        # Status bar
        Label:
            id: status_bar
            text: 'Ready'
            size_hint_y: None
            height: 30
            text_size: self.size
            halign: 'left'
            valign: 'middle'
            font_size: 12
            color: 0.6, 0.6, 0.6, 1 