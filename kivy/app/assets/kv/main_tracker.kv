# Main Tracker Screen Layout
# Kivy layout definition for the main habit tracking interface
# Updated to use custom table widget

<MainTrackerScreen>:
    name: 'main'
    
    # Connect UI elements to screen properties
    table_container: table_container
    status_bar: status_bar
    navigation_bar: navigation_bar
    
    BoxLayout:
        orientation: 'vertical'
        padding: dp(10)
        spacing: dp(10)
        
        # Header with title and navigation
        BoxLayout:
            id: navigation_bar
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(60)
            spacing: dp(10)
            
            Label:
                text: 'Habits Simple Tracker'
                font_size: '20sp'
                size_hint_x: 0.7
                
            Button:
                text: 'Options'
                size_hint_x: None
                width: dp(100)
                on_press: root.go_to_options()
        
        # Date navigation
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(50)
            spacing: dp(5)
            
            Button:
                text: '<'
                size_hint_x: None
                width: dp(50)
                on_press: root.navigate_previous()
                disabled: root.is_loading
                
            Label:
                text: root.week_label
                halign: 'center'
                
            Button:
                text: '>'
                size_hint_x: None
                width: dp(50)
                on_press: root.navigate_next()
                disabled: root.is_loading
                
            Button:
                text: 'Today'
                size_hint_x: None
                width: dp(80)
                on_press: root.go_to_today()
                disabled: root.is_loading
        
        # Loading indicator
        ProgressBar:
            id: loading_indicator
            size_hint_y: None
            height: dp(4)
            opacity: 1 if root.is_loading else 0
            
        # Main habit tracking table container
        ScrollView:
            id: table_container
            bar_width: 15
            bar_color: [0.5, 0.5, 0.5, 0.8]
            bar_inactive_color: [0.7, 0.7, 0.7, 0.4]
            scroll_type: ['bars', 'content']
            
            # Custom table widget will be added here programmatically
                
        # Status bar
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(30)
            padding: [dp(5), 0]
            
            Label:
                id: status_bar
                text: 'Ready'
                halign: 'left' 