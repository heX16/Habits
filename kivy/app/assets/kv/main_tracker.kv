# Main Tracker Screen Layout
# Kivy layout definition for the main habit tracking interface
# Updated to use KivyMD DataTable

<MainTrackerScreen>:
    name: 'main'
    
    # Connect UI elements to screen properties
    table_container: table_container
    status_bar: status_bar
    navigation_bar: navigation_bar
    
    MDBoxLayout:
        orientation: 'vertical'
        padding: dp(10)
        spacing: dp(10)
        md_bg_color: app.theme_cls.bg_normal
        
        # Header with title and navigation
        MDBoxLayout:
            id: navigation_bar
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(60)
            spacing: dp(10)
            
            MDLabel:
                text: 'Habits Simple Tracker'
                font_style: 'H5'
                theme_text_color: 'Primary'
                size_hint_x: 0.7
                
            MDRaisedButton:
                text: 'Options'
                size_hint_x: None
                width: dp(100)
                on_press: root.go_to_options()
        
        # Date navigation
        MDBoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(50)
            spacing: dp(5)
            
            MDIconButton:
                icon: 'chevron-left'
                size_hint_x: None
                width: dp(50)
                on_press: root.navigate_previous()
                disabled: root.is_loading
                
            MDLabel:
                text: root.week_label
                theme_text_color: 'Primary'
                halign: 'center'
                font_style: 'Body1'
                
            MDIconButton:
                icon: 'chevron-right'
                size_hint_x: None
                width: dp(50)
                on_press: root.navigate_next()
                disabled: root.is_loading
                
            MDRaisedButton:
                text: 'Today'
                size_hint_x: None
                width: dp(80)
                on_press: root.go_to_today()
                disabled: root.is_loading
        
        # Loading indicator
        MDProgressBar:
            id: loading_indicator
            size_hint_y: None
            height: dp(4)
            opacity: 1 if root.is_loading else 0
            
        # Main habit tracking table container
        MDCard:
            orientation: 'vertical'
            padding: dp(5)
            elevation: 2
            
            MDBoxLayout:
                id: table_container
                orientation: 'vertical'
                
                # MDDataTable will be added here programmatically
                
        # Status bar
        MDBoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(30)
            padding: [dp(5), 0]
            
            MDLabel:
                id: status_bar
                text: 'Ready'
                theme_text_color: 'Secondary'
                font_style: 'Caption'
                halign: 'left' 